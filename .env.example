# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# This project cannot talk to the live PayPal environment.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI provider: set one key. With no key, ReconPilot uses rule-based explanations.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_PROVIDER=auto        # auto | anthropic | gemini

# Optional: write the audit trail to a JSONL file
# AUDIT_LOG_PATH=audit.jsonl
